{
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0",
    "html-validate": "^11.16.2"
  },
  "scripts": {
    "test": "node --test tests/payments.test.mjs tests/downloads.test.mjs backend/functions/tests/*.test.js",
    "test:rules": "firebase emulators:exec --config firebase.json --only firestore,auth --project demo-unlim8ted-security \"node --test tests/firestore.test.mjs tests/auth.test.mjs\"",
    "test:html": "node tests/html-check.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:syntax": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tests/syntax-check.mjs"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "basic-ftp": "6.2.3"
  }
}
