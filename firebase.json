{
  "firestore": {
    "rules": "backend/rules/database.rules",
    "indexes": "backend/rules/firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "auth": {
      "port": 9099
    }
  },
  "functions": [
    {
      "source": "backend/functions",
      "codebase": "notifications",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env.example",
        "tests"
      ]
    }
  ]
}
